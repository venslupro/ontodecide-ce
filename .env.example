# Cloudflare account configuration (required for Terraform & Wrangler).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Neo4j AuraDB Free (provisioned manually, credentials from console).
NEO4J_URL=https://xxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# JWT signing secret for the Gateway Worker (use `openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-long-random-string

# LLM provider keys (only the active provider needs to be set).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Frontend API base URL (Vite build-time injection).
# Leave EMPTY: the SPA calls same-origin /api/*, which the Pages Function
# (apps/web/functions/api/[[path]].ts) proxies to the Gateway worker via
# the GATEWAY_SERVICE Service Binding. Only set this for deployments
# without the Pages Function proxy.
VITE_API_BASE=

# NOTE: internal service routing uses Cloudflare Service Bindings declared
# in each wrangler.toml [[services]] block — no public service URLs needed.
