# Example tfvars — copy to terraform.tfvars and fill in real values before use.
# NEVER commit real tokens from this file to git — terraform.tfvars is excluded via .gitignore.

account_id   = "0123456789abcdef0123456789abcdef"   # 32-char Cloudflare Account ID
zone_id      = ""                                     # Leave empty to skip custom domain creation
project_name = "ontodecide"
environment  = "production"

# External dependency defaults (aligned with wrangler.toml; real B2 buckets / Neo4j managed by external IaC)
# B2 bucket naming convention: ontodecide-prd-{purpose}
b2_region           = "us-west-004"
b2_ingestion_bucket = "ontodecide-prd-ingestion-staging"
b2_archive_bucket   = "ontodecide-prd-tenant-archive"
