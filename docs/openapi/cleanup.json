          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tenantId": {
                    "type": "string",
                    "description": "Limit cleanup to a single tenant. If omitted, all due tenants run."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "soft",
                      "hard"
                    ],
                    "description": "Soft keeps audit + backups, hard purges everything including archives."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cleanup task enqueued.",
