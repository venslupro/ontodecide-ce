// Cloudflare Pages project for the cockpit SPA (production only; deployed
// from main by .github/workflows/deploy.yml via Direct Upload). The project
// name is exempt from {project}-{env}-{service}: it fixes the public URL
// https://ontodecide-ce.pages.dev. The GATEWAY binding (named by the rule)
// is used only by the fallback Pages Function functions/api/[[path]].ts
// while APP_DOMAIN is empty; with a domain the deploy removes functions/ and
// /api/* reaches api-gateway through its Workers Route.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ontodecide-ce",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-01",
  "services": [{"binding": "GATEWAY", "service": "ontodecide-prd-api-gateway"}]
}
