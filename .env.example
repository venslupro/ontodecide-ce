# OntoDecide CE V2.4 — settings reference. Never commit real values.
#
# Local development needs none of this: `pnpm dev` renders wrangler configs
# with dev-only values and generates stable dev secrets once into
# .wrangler/dev-secrets.json (JWT key, pepper, admin setup code; Turnstile
# always-pass test keys; EMAIL_MODE=log, so codes appear in the log).
# Local bootstrap admin: admin@ontodecide.local.
#
# The manual scripts (scripts/reset.sh, scripts/cleanup_legacy.sh) read the
# CI names below from .env.local (chmod 600).

# ============ GitHub Actions secrets (Settings → Secrets → Actions) ========

# ---- Cloudflare ----
# API token: Account → Workers Scripts/Routes, D1, Queues, Pages, Turnstile,
# Account Rulesets + Account Filter Lists (Edit); Zone → DNS, Zone Settings,
# Zone WAF, Single Redirect / Dynamic Redirect rules (Edit) on APP_DOMAIN.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ---- Backblaze B2 ----
# Master (or keys-capable) key for the Terraform b2 provider: creates the
# archive bucket and its application keys.
B2_MASTER_KEY_ID=
B2_MASTER_KEY=
# Key scoped to the hand-made state bucket ontodecide-ce-tfstate (S3 backend;
# optional — falls back to the master key).
B2_STATE_KEY_ID=
B2_STATE_KEY=

# ---- Neo4j Aura (legacy) ----
# Only while infra/legacy.tf still forgets the V1.3 instance; delete after
# scripts/cleanup_legacy.sh and the removal of that block.
NEO4J_AURA_CLIENT_ID=
NEO4J_AURA_CLIENT_SECRET=

# ---- identity-access Worker secrets (uploaded with `wrangler secret bulk`) ----
# Generate with `node scripts/gen_secrets.mjs`.
# Ed25519 private JWK with kid (yyyy-mm). api-gateway gets only the public
# part (JWT_PUBLIC_KEYS, rendered at deploy time).
JWT_SIGNING_KEY=
# Previous signing key during a rotation (optional; remove when its tokens
# have expired).
JWT_SIGNING_KEY_PREV=
# HMAC key for e-mail / IP hashes and AES-GCM key for stored addresses.
# Never change them after the first deploy.
EMAIL_PEPPER=
EMAIL_ENC_KEY=
# One-time code for binding the first admin passkey (give it to operators
# only; void after the first passkey).
BOOTSTRAP_ADMIN_SETUP_CODE=
# Resend (primary) and Brevo (fallback); disable open / click tracking in
# both accounts.
RESEND_API_KEY=
BREVO_API_KEY=
# Optional: Cloudflare API token with Account Analytics Read (hourly check
# that closes sign-up at 80 % of the daily free quotas).
CF_ANALYTICS_TOKEN=
# Not GitHub secrets — taken from Terraform outputs at deploy time:
#   TURNSTILE_SECRET, B2_WRITE_KEY_ID, B2_WRITE_APP_KEY, B2_SIGN_KEY_ID,
#   B2_SIGN_APP_KEY

# ============ GitHub Actions variables (Settings → Variables → Actions) ===

# Environment `production` variable (the approval environment).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Repository variables.
# Apex domain added to the Cloudflare account (zone created by Terraform);
# the app is served at https://ontodecide-ce.${APP_DOMAIN}. Empty:
# https://ontodecide-ce.pages.dev with the Pages Functions /api proxy.
APP_DOMAIN=
# Sender verified in Resend and Brevo (default with a domain:
# OntoDecide CE <noreply@mail.${APP_DOMAIN}>; required without one).
MAIL_FROM=OntoDecide CE <noreply@mail.example.com>
# live (default) sends e-mails; log only logs them (no provider needed).
EMAIL_MODE=live
# DMARC policy: none (default) for two weeks, then quarantine.
DMARC_POLICY=none
# Resend / Brevo sender-domain records as JSON (Terraform var
# mail_dns_records), e.g.
# [{"name":"resend._domainkey.mail","type":"TXT","content":"p=MIGf…"},
#  {"name":"send.mail","type":"MX","content":"feedback-smtp.us-east-1.amazonses.com","priority":10}]
MAIL_DNS_RECORDS=[]
# Archive signing key slot (a | b); switch monthly, see infra/variables.tf.
ARCHIVE_SIGN_SLOT=a
# true for ONE deploy of the V1.3 → V2.4 rollout: drops the V1.3 schema of
# the five D1 databases (all their data) before the V2.4 migrations. Remove
# it afterwards.
D1_RESET_LEGACY=
