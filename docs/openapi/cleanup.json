                      "type": "object",
                      "properties": {
                        "taskId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "taskId"
                      ],
                      "description": "Response payload on success."
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Stable error code, e.g. AUTH_INVALID_CREDENTIALS."
                        },
                        "message": {
                          "type": "string",
                          "description": "Human-readable message in the user locale."
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Optional field-level validation details."
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "description": "Error details on failure."
                    },
                    "traceId": {
                      "type": "string",
                      "description": "Server-side trace id, useful for debugging."
                    }
                  },
                  "required": [
                    "success"
                  ]
