# Example input variables — copy and adapt as needed.
#
# THIS FILE IS AN EXAMPLE TEMPLATE. NEVER commit a real tfvars file
# with secrets to the repository.
#
# Preferred usage per Cloudflare best practice:
#   1. Export secrets as shell environment variables so they never
#      touch a plaintext file on disk:
#
#        export CLOUDFLARE_API_TOKEN="..."
#        export TF_VAR_jwt_secret="..."
#        export TF_VAR_neo4j_password="..."
#        export TF_VAR_cloudflare_account_id_or_workers_dev="..."
#
#   2. Keep ONLY NON-SENSITIVE defaults in a tfvars file if desired,
#      or skip tfvars entirely and use TF_VAR_* for everything.
#
#   3. When following the "separate Cloudflare accounts per
#      environment" best practice, each account's deployment needs
#      only ONE tfvars (or nothing — use defaults + env variables).

# ---- Non-sensitive configuration (safe for tfvars file) ----

# cloudflare_account_id can be omitted if the API token has Account
# List permissions — Terraform will auto-discover it.
cloudflare_account_id = "your-account-id-here"

project_name = "ontodecide"
environment  = "production"

neo4j_url  = "https://xxxxxxxx.databases.neo4j.io"
neo4j_user = "neo4j"

default_provider = "workers-ai"
workers_ai_model = "@cf/meta/llama-3-8b-instruct"

# Backblaze B2 region code (find in B2 dashboard → Buckets).
b2_region = "us-west-004"

# ---- DO NOT PUT SECRETS HERE ----
#
# The following are handled via environment variables (see top of
# this file) and must never appear in a committed tfvars:
#
#   - CLOUDFLARE_API_TOKEN
#   - TF_VAR_jwt_secret
#   - TF_VAR_neo4j_password
#   - TF_VAR_cloudflare_account_id_or_workers_dev
#   - R2 state backend: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   - TF_VAR_b2_application_key_id  (B2 S3-compatible access key)
#   - TF_VAR_b2_application_key   (B2 S3-compatible secret key)
