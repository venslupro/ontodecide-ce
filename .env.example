# Cloudflare account configuration (required for Terraform & Wrangler).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Neo4j AuraDB Free (provisioned manually, credentials from console).
NEO4J_URL=https://xxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# JWT signing secret for the Gateway Worker (use `openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-long-random-string

# LLM provider keys (only the active provider needs to be set).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Internal service base URLs (Workers internal routes).
USER_SERVICE_URL=https://decision-user.<account>.workers.dev
GRAPH_SERVICE_URL=https://decision-graph.<account>.workers.dev
INGESTION_SERVICE_URL=https://decision-ingestion.<account>.workers.dev
AI_SERVICE_URL=https://decision-ai.<account>.workers.dev
CLEANUP_SERVICE_URL=https://decision-cleanup.<account>.workers.dev
