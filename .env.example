# Local development needs no secrets: `pnpm dev` renders wrangler configs
# with dev-only values (see scripts/gen_wrangler.mjs LOCAL_SECRETS).
# Bootstrap admin for local dev: admin@ontodecide.local / Admin12345!

# ---- CI / deployment (GitHub Actions secrets, never commit real values) ----
# Cloudflare
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Backblaze B2: admin key for the Terraform b2 provider, and a key scoped
# to the ontodecide-ce-tfstate bucket for the S3 state backend.
B2_MASTER_KEY_ID=
B2_MASTER_KEY=
B2_STATE_KEY_ID=
B2_STATE_KEY=
# Neo4j Aura API client (Terraform neo4jaura provider)
NEO4J_AURA_CLIENT_ID=
NEO4J_AURA_CLIENT_SECRET=
# Worker secrets (uploaded with `wrangler secret bulk`)
JWT_SECRET=k1:replace-with-openssl-rand-hex-32
APPROVAL_SECRET=replace-with-openssl-rand-hex-32
WRITEBACK_SECRET=replace-with-openssl-rand-hex-32
CONNECTOR_ENC_KEY=replace-with-openssl-rand-hex-32
BOOTSTRAP_ADMIN_PASSWORD=
GEMINI_API_KEY=
GROQ_API_KEY=
# GitHub Actions variable (not secret)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
