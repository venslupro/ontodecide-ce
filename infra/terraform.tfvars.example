# Copy to terraform.tfvars (gitignored) or pass TF_VAR_* in CI.
account_id = "your-cloudflare-account-id"
b2_region  = "us-east-005"

# Resource names are {project}-{environment}-{service}; defaults shown.
# project     = "ontodecide"
# environment = "prd"

# Custom domain (CI: GitHub variable APP_DOMAIN → TF_VAR_domain). The zone
# must already exist in the Cloudflare account (owned by another project);
# Terraform only looks it up here, attaches the Pages custom domain
# https://ontodecide-ce.<domain> and bulk-redirects the pages.dev host to it.
# Empty keeps the app on https://ontodecide-ce.pages.dev with the Pages
# Functions proxy.
# domain = "example.com"

# Archive signing key slot used for new links (monthly rotation, see
# variables.tf).
# archive_sign_active = "a"
