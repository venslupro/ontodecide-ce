{
  "name": "@ontodecide/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Ingestion Service: ETL pipeline with sync (small) and async (R2+Queue) paths.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@ontodecide/shared": "workspace:*",
    "hono": "^4.13.3",
    "hyparquet": "^1.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "apache-arrow": "^21.2.0",
    "parquet-wasm": "^0.8.0"
  }
}
